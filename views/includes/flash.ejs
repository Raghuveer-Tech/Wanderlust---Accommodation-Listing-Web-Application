<% if(success && success.length){ %>
    <div class="row mt-3">
        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center col-10 col-md-6 offset-1 offset-md-3 shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2 fs-5"></i>
            <div class="flex-grow-1"><%= success %></div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    </div>
<% } %>

<% if(error && error.length){ %>
    <div class="row mt-3">
        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center col-10 col-md-6 offset-1 offset-md-3 shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
            <div class="flex-grow-1"><%= error %></div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    </div>
<% } %>